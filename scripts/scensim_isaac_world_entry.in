#!/usr/bin/env bash
# `ros2 run scensim_isaac_world @ENTRY_NAME@`: `python -m @ENTRY_MODULE@`, the installed package
# (SCENSIM_ISAAC_DIR: a source tree's instead), in @ENTRY_PYTHON@ Python
# (configured by CMakeLists.txt from scripts/scensim_isaac_world_entry.in).
#
#   isaac:  Isaac Sim's own Python and ROS 2 libraries (scripts/isaac_env.sh; ISAAC_ROOT), the
#           system Humble dropped first, as scensim_isaac_world_server does;
#   system: the system python3 (numpy and PyYAML; matplotlib for pictures).
set -e
# Where the package runs from: installed (the default; roadmap 082), this script's prefix,
# <prefix>/lib/scensim_isaac_world, or a source tree a developer names, SCENSIM_ISAAC_DIR.
# Installed, isaac_env.sh finds aib, the shell and the vehicle packages in the prefixes the
# launch ran under: AMENT_PREFIX_PATH, kept as SCENSIM_PREFIX_PATH before it is dropped below.
export SCENSIM_PREFIX_PATH="${AMENT_PREFIX_PATH:-}"
if [ -n "${SCENSIM_ISAAC_DIR:-}" ]; then
    isaac_env="$SCENSIM_ISAAC_DIR/scripts/isaac_env.sh"
else
    isaac_env="$(cd "$(dirname "$0")/../.." && pwd)/share/scensim_isaac_world/scripts/isaac_env.sh"
fi
if [ "@ENTRY_PYTHON@" = isaac ]; then
    unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH \
        COLCON_PREFIX_PATH PKG_CONFIG_PATH ROS_PACKAGE_PATH ROS_LOCALHOST_ONLY ROS_VERSION \
        ROS_PYTHON_VERSION VIRTUAL_ENV
    PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '^/opt/ros/\|^/opt/autoware/\|/install/' | paste -sd:)
    # ISAAC_ROOT: no default (isaac_env.sh refuses it unset or not an install)
    # shellcheck source=/dev/null
    source "$isaac_env" || exit 2
    py=python
else
    py=python3
fi
# Relative paths in the arguments stay the caller's: the package is found by PYTHONPATH
# (installed: isaac_env.sh's, or, system Python, setup.bash's; a source tree: put first).
if [ -n "${SCENSIM_ISAAC_DIR:-}" ]; then
    export PYTHONPATH="$SCENSIM_ISAAC_DIR${PYTHONPATH:+:$PYTHONPATH}"
fi
exec "$py" -u -m @ENTRY_MODULE@ "$@"
