<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scensim_isaac_world</name>
  <version>0.1.0</version>
  <description>Isaac Sim behind the world protocol of scensim: the Isaac world server</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- What the world server imports, installed under the prefix (roadmap 082): the protocol's
       Python shell, aib (the ego; it imports sim_vehicle_spec and sim_vehicle_ecu). The
       scripts find each in AMENT_PREFIX_PATH's site- or dist-packages, for Isaac's own Python.
       aib is not declared: it lives in autoware_isaac_bridge, whose aib_launch needs Autoware,
       which a simulation-only host has not (rosdep would fail on it); found at run time,
       refused by name when absent. -->
  <exec_depend>scensim_world_server</exec_depend>
  <exec_depend>sim_vehicle_spec</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
